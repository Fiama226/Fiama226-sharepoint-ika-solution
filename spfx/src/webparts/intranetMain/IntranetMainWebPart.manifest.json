{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "a3c2e7f1-9b8d-4a5e-8c1f-0b2d6a4c8e91",
  "alias": "IntranetMainWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab"],
  "supportsThemeVariants": true,
  "supportsFullBleed": true,
  "flexibleLayoutSizing": {
    "supportsDynamicResizing": true,
    "defaultRowHeight": 18,
    "defaultColumnWidth": 12
  },
  "preconfiguredEntries": [
    {
      "groupId": "6f2b1c48-0d3a-4e7b-9a15-000000000000",
      "group": { "default": "IKA Solution" },
      "title": { "default": "IKA — Intranet (composant principal)" },
      "description": {
        "default": "Composant UNIQUE qui reconstruit à l'identique la page d'accueil du site Next.js : Hero slider animé, annonces défilantes, actualités, accès rapide, galerie, équipe, collaborateur du mois et projets. Une Web Part = toute la page d'accueil."
      },
      "officeFabricIconFontName": "Globe2",
      "properties": {
        "height": "large",
        "accent": "orange",
        "animationsEnabled": true,
        "showHero": true,
        "showClock": true,
        "showWelcomePanel": true,
        "showMarquee": true,
        "showNews": true,
        "showQuickAccess": true,
        "showGallery": true,
        "showTeam": true,
        "showEmployee": true,
        "showProjects": true
      }
    }
  ]
}
