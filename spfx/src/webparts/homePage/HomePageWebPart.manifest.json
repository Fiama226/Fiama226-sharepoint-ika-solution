{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "b2f1a4d8-7e6c-4a3b-9d52-0f1c8a3b5e67",
  "alias": "HomePageWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab"],
  "supportsThemeVariants": true,
  "supportsFullBleed": true,
  "flexibleLayoutSizing": {
    "supportsDynamicResizing": true,
    "defaultRowHeight": 18,
    "defaultColumnWidth": 12
  },
  "preconfiguredEntries": [
    {
      "groupId": "6f2b1c48-0d3a-4e7b-9a15-000000000000",
      "group": { "default": "IKA Solution" },
      "title": { "default": "IKA — Page d'accueil complète" },
      "description": {
        "default": "Assemble en une seule Web Part toutes les sections de la page d'accueil (Hero, annonces, actualités, accès rapide, galerie, équipe, collaborateur du mois, projets) afin de reconstituer la page du site statique."
      },
      "officeFabricIconFontName": "Home",
      "properties": {
        "height": "large",
        "showHero": true,
        "showMarquee": true,
        "showNews": true,
        "showQuickAccess": true,
        "showGallery": true,
        "showTeam": true,
        "showEmployee": true,
        "showProjects": true
      }
    }
  ]
}
