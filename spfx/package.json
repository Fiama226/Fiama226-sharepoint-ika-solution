{
  "name": "ika-intranet",
  "version": "1.0.2",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "build": "heft test --clean --production && heft package-solution --production",
    "build:tailwind": "node config/build-tailwind.js",
    "clean": "heft clean",
    "dev": "npm run build:tailwind && heft start --clean",
    "eject-webpack": "heft eject-webpack",
    "package": "heft package-solution --production",
    "ship": "heft test --clean --production && heft package-solution --production",
    "start": "heft start --clean",
    "test": "heft test --production",
    "trust-cert": "heft trust-dev-cert",
    "validate": "node config/validate.js && node config/run-unit-tests.js"
  },
  "dependencies": {
    "@microsoft/sp-application-base": "1.23.2",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.6.2"
  },
  "devDependencies": {
    "@microsoft/decorators": "1.23.2",
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
