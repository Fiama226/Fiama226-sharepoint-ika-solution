# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SPFx / Heft artifacts (build, dev certs, generated bundle)
/spfx/node_modules
/spfx/lib
/spfx/dist
/spfx/temp
/spfx/out
/spfx/.heft
/spfx/sharepoint/solution
/spfx/.cert
/spfx/src/styles/tailwind.compiled.css
/spfx/coverage

# Workbench dev outputs
/spfx/lib
/spfx/temp
*.sppkg
*.sppkg.js
.sp-pnp

# Docker build artifacts (when using docker compose out volume)
/out
/docker-out
